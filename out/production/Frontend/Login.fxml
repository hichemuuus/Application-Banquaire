<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.demo1.LoginController"
      alignment="CENTER"
      spacing="0"
      style="-fx-background-color: #1a1a2e;">

    <!-- Header -->
    <VBox alignment="CENTER" spacing="6" style="-fx-padding: 50 40 30 40;">
        <Label text="🏦" style="-fx-font-size: 42px;"/>
        <Label text="FAKE BANK"
               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #e2e8f0;"/>
        <Label text="Système de gestion bancaire distribuée"
               style="-fx-font-size: 12px; -fx-text-fill: #718096;"/>
    </VBox>

    <!-- Card -->
    <VBox spacing="16"
          style="-fx-background-color: #16213e; -fx-background-radius: 12;
                 -fx-padding: 30 36 30 36; -fx-effect: dropshadow(gaussian, #0d0d1a, 20, 0.3, 0, 4);">
        <VBox.margin>
            <Insets left="40" right="40"/>
        </VBox.margin>

        <!-- Server -->
        <VBox spacing="5">
            <Label text="Adresse du serveur"
                   style="-fx-font-size: 11px; -fx-font-weight: bold;
                          -fx-text-fill: #a0aec0; -fx-padding: 0 0 0 2;"/>
            <TextField fx:id="serverField"
                       promptText="localhost ou 192.168.x.x"
                       text="localhost"
                       style="-fx-background-color: #0f3460; -fx-text-fill: #e2e8f0;
                              -fx-prompt-text-fill: #4a5568; -fx-border-color: #2d3748;
                              -fx-border-radius: 6; -fx-background-radius: 6;
                              -fx-padding: 10 12; -fx-font-size: 13px;"/>
        </VBox>

        <!-- Login -->
        <VBox spacing="5">
            <Label text="Login"
                   style="-fx-font-size: 11px; -fx-font-weight: bold;
                          -fx-text-fill: #a0aec0; -fx-padding: 0 0 0 2;"/>
            <TextField fx:id="loginField"
                       promptText="admin"
                       style="-fx-background-color: #0f3460; -fx-text-fill: #e2e8f0;
                              -fx-prompt-text-fill: #4a5568; -fx-border-color: #2d3748;
                              -fx-border-radius: 6; -fx-background-radius: 6;
                              -fx-padding: 10 12; -fx-font-size: 13px;"/>
        </VBox>

        <!-- Password -->
        <VBox spacing="5">
            <Label text="Mot de passe"
                   style="-fx-font-size: 11px; -fx-font-weight: bold;
                          -fx-text-fill: #a0aec0; -fx-padding: 0 0 0 2;"/>
            <PasswordField fx:id="passwordField"
                           promptText="••••••••"
                           style="-fx-background-color: #0f3460; -fx-text-fill: #e2e8f0;
                                  -fx-prompt-text-fill: #4a5568; -fx-border-color: #2d3748;
                                  -fx-border-radius: 6; -fx-background-radius: 6;
                                  -fx-padding: 10 12; -fx-font-size: 13px;"/>
        </VBox>

        <!-- Message -->
        <Label fx:id="messageLabel" text=""
               style="-fx-font-size: 12px; -fx-padding: 0 0 0 2;"
               wrapText="true"/>

        <!-- Button -->
        <Button fx:id="btnConnecter"
                text="Se connecter"
                onAction="#seConnecter"
                maxWidth="Infinity"
                style="-fx-background-color: #4361ee; -fx-text-fill: white;
                       -fx-font-size: 14px; -fx-font-weight: bold;
                       -fx-background-radius: 6; -fx-padding: 12 0;
                       -fx-cursor: hand;"/>
    </VBox>

    <!-- Footer -->
    <Label text="USTO-MB · POO2 · TP6 — Java RMI"
           style="-fx-font-size: 10px; -fx-text-fill: #4a5568; -fx-padding: 20 0 0 0;"/>

</VBox>
